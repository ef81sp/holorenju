# === バージョン管理 ===
# pnpm add 時にバージョンを固定（^ を付けない）
save-exact=true

# === Lockfile ===
# lockfile が package.json と一致する場合、解決をスキップして高速インストール
prefer-frozen-lockfile=true

# === ストア整合性 ===
# ストア内ファイルの改竄検知
verify-store-integrity=true
# パッケージ名・バージョンの厳密チェック
strict-store-pkg-content-check=true

# === エンジン制約 ===
# engines フィールドを強制（Node >= 24.0.0）
engine-strict=true

# === ビルドスクリプト ===
# 未レビューのビルドスクリプトがあればインストール失敗
strict-dep-builds=true

# === 依存解決セキュリティ ===
# 推移的依存が git/tarball など非レジストリソースを使うのをブロック
block-exotic-subdeps=true

# === SSL ===
# レジストリ接続時のSSL証明書検証
strict-ssl=true

# === キャッシュ ===
# ビルド済み依存のキャッシュ
side-effects-cache=true
